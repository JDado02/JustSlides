<Window x:Class="Regia.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        Title="Impostazioni evento" Width="640" Height="700" MinWidth="520" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="Monitor di output" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6" />
        <ListBox ItemsSource="{Binding Monitors}" SelectedItem="{Binding SelectedMonitor}" MinHeight="90">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
              <Setter Property="IsEnabled" Value="{Binding IsSelectable}" />
              <Setter Property="ToolTip" Value="{Binding Tooltip}" />
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Display}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
          <Button Content="Identifica monitor" Command="{Binding IdentifyCommand}" />
        </StackPanel>
        <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                   Text="Il monitor della regia non può essere scelto come output. Con un solo monitor usa la modalità simulazione." />

        <CheckBox Margin="0,18,0,0" IsChecked="{Binding SimulationMode}"
                  Content="Modalità simulazione (output in una finestra sul monitor principale)" />

        <TextBlock Text="Cartella contenuti" FontSize="16" FontWeight="SemiBold" Margin="0,22,0,6" />
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Sfoglia..." Margin="8,0,0,0" Command="{Binding BrowseSourceFolderCommand}" />
          <TextBox Text="{Binding SourceFolder, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>
        <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                   Text="I file messi qui (anche nelle sottocartelle, che diventano le sessioni) compaiono da soli in scaletta. La regia lavora sempre su una copia locale: la cartella può stare in rete o su chiavetta." />

        <TextBlock Text="Tappo" FontSize="16" FontWeight="SemiBold" Margin="0,22,0,6" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <RadioButton Content="Immagine" IsChecked="{Binding IsImageTappo}" GroupName="TappoKind" />
          <RadioButton Content="Video in loop" IsChecked="{Binding IsVideoTappo}" GroupName="TappoKind" />
        </StackPanel>
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Sfoglia..." Margin="8,0,0,0" Command="{Binding BrowseTappoCommand}" />
          <TextBox Text="{Binding TappoPath, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>

        <TextBlock Text="Uscita audio" FontSize="16" FontWeight="SemiBold" Margin="0,22,0,6" />
        <ListBox ItemsSource="{Binding AudioDevices}" SelectedItem="{Binding SelectedAudioDevice}"
                 DisplayMemberPath="Display" MinHeight="70" MaxHeight="150" />
        <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                   Text="Vale per i video. PowerPoint suona sempre sul dispositivo predefinito di Windows (il volume e il Mute della regia agiscono comunque sul suo audio)." />
        <TextBlock Foreground="#FFFFD79A" TextWrapping="Wrap" Margin="0,6,0,0" Text="{Binding PptAudioNote}">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding HasPptAudioNote}" Value="True">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>

        <TextBlock Text="Dissolvenza" FontSize="16" FontWeight="SemiBold" Margin="0,22,0,6" />
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" Width="70" TextAlignment="Right" VerticalAlignment="Center"
                     Text="{Binding FadeDurationMs, StringFormat={}{0:0} ms}" />
          <Slider Minimum="{Binding MinFade}" Maximum="{Binding MaxFade}" Value="{Binding FadeDurationMs}"
                  TickFrequency="50" IsSnapToTickEnabled="True" SmallChange="50" LargeChange="100"
                  VerticalAlignment="Center" />
        </DockPanel>
        <CheckBox Margin="0,8,0,0" IsChecked="{Binding HardCut}" Content="Taglio secco (nessuna dissolvenza)" />
      </StackPanel>
    </ScrollViewer>

    <DockPanel Grid.Row="1" Margin="0,16,0,0">
      <Button DockPanel.Dock="Right" Content="Chiudi" Margin="8,0,0,0" Click="OnCloseClick" />
      <Button DockPanel.Dock="Right" Content="Applica" Background="#FF1F5FBF" Command="{Binding ApplyCommand}" />
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center"
                 Foreground="{StaticResource MutedBrush}" Margin="0,0,12,0" />
    </DockPanel>
  </Grid>
</Window>
