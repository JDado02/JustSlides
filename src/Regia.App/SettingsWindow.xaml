<Window x:Class="Regia.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ppt="clr-namespace:Regia.Core.Ppt;assembly=Regia.Core"
        Style="{StaticResource {x:Type Window}}"
        Title="Impostazioni evento" Width="920" Height="860" MinWidth="640" MinHeight="560"
        Icon="pack://application:,,,/Regia.Output;component/Assets/JustSlides.ico"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </Window.Resources>
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="Monitor di output" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6" />
        <ListBox ItemsSource="{Binding Monitors}" SelectedItem="{Binding SelectedMonitor}" MinHeight="90">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
              <Setter Property="IsEnabled" Value="{Binding IsSelectable}" />
              <Setter Property="ToolTip" Value="{Binding Tooltip}" />
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Display}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
          <Button Content="Identifica monitor" Command="{Binding IdentifyCommand}" />
        </StackPanel>
        <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                   Text="Il monitor della regia non può essere scelto come output. Con un solo monitor usa la modalità simulazione." />

        <CheckBox Margin="0,18,0,0" IsChecked="{Binding SimulationMode}"
                  Content="Modalità simulazione (output in una finestra sul monitor principale)" />
        <TextBlock Foreground="{StaticResource WarnTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0" Text="{Binding SimulationFallbackNote}">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding HasSimulationFallbackNote}" Value="True">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>

        <TextBlock Text="Cartella contenuti" FontSize="15" FontWeight="SemiBold" Margin="0,22,0,6" />
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Sfoglia..." Margin="8,0,0,0" Command="{Binding BrowseSourceFolderCommand}" />
          <TextBox Text="{Binding SourceFolder, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>
        <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                   Text="I file messi qui (anche nelle sottocartelle, che diventano le sessioni) compaiono da soli in scaletta. La regia lavora sempre su una copia locale: la cartella può stare in rete o su chiavetta." />

        <TextBlock Text="Tappo" FontSize="15" FontWeight="SemiBold" Margin="0,22,0,6" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <RadioButton Content="Immagine" IsChecked="{Binding IsImageTappo}" GroupName="TappoKind" />
          <RadioButton Content="Video in loop" IsChecked="{Binding IsVideoTappo}" GroupName="TappoKind" />
          <RadioButton Content="PowerPoint (solo immagini)" IsChecked="{Binding IsSlidesTappo}" GroupName="TappoKind" Margin="0" />
        </StackPanel>
        <DockPanel>
          <DockPanel.Style>
            <Style TargetType="DockPanel">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsImageTappo}" Value="True">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </DockPanel.Style>
          <Button DockPanel.Dock="Right" Content="Sfoglia..." Margin="8,0,0,0" Command="{Binding BrowseTappoCommand}"
                  ToolTip="Scegli un'immagine (anche più di una), un video o una presentazione PowerPoint" />
          <TextBox Text="{Binding TappoPath, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>

        <!-- Tappo immagine: Fissa (una sola) oppure Loop (più immagini) -->
        <StackPanel Margin="0,8,0,0">
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsImageTappo}" Value="True">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <RadioButton Content="Fissa" IsChecked="{Binding IsImageFixed}" GroupName="TappoImageMode"
                         ToolTip="Una sola immagine, sempre quella" />
            <RadioButton Content="Loop" IsChecked="{Binding ImageLoop}" GroupName="TappoImageMode" Margin="0"
                         ToolTip="Più immagini che scorrono una dopo l'altra" />
          </StackPanel>
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Margin="8,0,0,0">
              <Button Content="Sfoglia..." Command="{Binding BrowseTappoCommand}" Padding="10,4"
                      ToolTip="Sostituisce la scelta; qui puoi scegliere anche un video o una presentazione PowerPoint" />
              <StackPanel Visibility="{Binding ImageLoop, Converter={StaticResource BoolToVis}}">
                <Button Content="Aggiungi..." Command="{Binding AddTappoImagesCommand}" Padding="10,4" Margin="0,6,0,0" />
                <Button Content="&#9650; Su" Command="{Binding MoveTappoImageUpCommand}" Padding="10,4" Margin="0,6,0,0" />
                <Button Content="&#9660; Giù" Command="{Binding MoveTappoImageDownCommand}" Padding="10,4" Margin="0,6,0,0" />
                <Button Content="Togli" Command="{Binding RemoveTappoImageCommand}" Padding="10,4" Margin="0,6,0,0" />
              </StackPanel>
            </StackPanel>
            <ListBox ItemsSource="{Binding TappoImages}" SelectedItem="{Binding SelectedTappoImage}"
                     MinHeight="70" MaxHeight="160" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ToolTip="Nessuna immagine = Tappo nero">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </StackPanel>

        <!-- Tappo PowerPoint: Loop / Fermo -->
        <StackPanel Margin="0,10,0,0">
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsSlidesTappo}" Value="True">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>
          <StackPanel Orientation="Horizontal">
            <RadioButton Content="Loop" IsChecked="{Binding SlidesLoop}" GroupName="TappoSlidesMode" />
            <RadioButton Content="Fermo su una slide" IsChecked="{Binding SlidesHold}" GroupName="TappoSlidesMode" Margin="0" />
          </StackPanel>
        </StackPanel>

        <!-- Secondi per slide/immagine: scritti a tastiera -->
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Visibility="{Binding ShowSeconds, Converter={StaticResource BoolToVis}}">
          <TextBlock Text="{Binding SecondsLabel}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
          <TextBox Text="{Binding SlideSecondsText, UpdateSourceTrigger=PropertyChanged}" Width="70" MaxLength="3"
                   TextAlignment="Right" PreviewTextInput="OnDigitsOnly" DataObject.Pasting="OnPasteDigitsOnly" />
          <TextBlock Text="secondi (2-120)" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="10,0,0,0" />
        </StackPanel>

        <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0" Text="{Binding TappoNote}"
                   Visibility="{Binding HasTappoNote, Converter={StaticResource BoolToVis}}" />

        <TextBlock Text="Uscita audio" FontSize="15" FontWeight="SemiBold" Margin="0,22,0,6" />
        <ListBox ItemsSource="{Binding AudioDevices}" SelectedItem="{Binding SelectedAudioDevice}"
                 DisplayMemberPath="Display" MinHeight="70" MaxHeight="150" />
        <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                   Text="Vale per i video. PowerPoint suona sempre sul dispositivo predefinito di Windows (il volume e il Mute della regia agiscono comunque sul suo audio)." />
        <TextBlock Foreground="{StaticResource WarnTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0" Text="{Binding PptAudioNote}">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding HasPptAudioNote}" Value="True">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>

        <!-- Verifica PowerPoint: solo su richiesta (nessun controllo all'avvio) -->
        <TextBlock Text="PowerPoint" FontSize="15" FontWeight="SemiBold" Margin="0,22,0,6" />
        <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Controlla che PowerPoint sia installato e funzioni, con una prova di pochi secondi (crea, salva e riapre una presentazione di prova). Solo con la regia a Tappo." />
        <Button Content="{Binding PptCheckButtonText}" Command="{Binding VerifyPptCommand}" HorizontalAlignment="Left" Padding="16,8" />
        <Border Margin="0,10,0,0" CornerRadius="6" Padding="12,10" BorderThickness="1"
                Visibility="{Binding HasPptCheckResult, Converter={StaticResource BoolToVis}}">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Background" Value="{StaticResource OkBgBrush}" />
              <Setter Property="BorderBrush" Value="{StaticResource OkBorderBrush}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding PptCheckLevel}" Value="{x:Static ppt:PptCheckLevel.Warning}">
                  <Setter Property="Background" Value="{StaticResource WarnBgBrush}" />
                  <Setter Property="BorderBrush" Value="{StaticResource WarnBorderBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding PptCheckLevel}" Value="{x:Static ppt:PptCheckLevel.Error}">
                  <Setter Property="Background" Value="{StaticResource DangerBgBrush}" />
                  <Setter Property="BorderBrush" Value="{StaticResource DangerBorderBrush}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <StackPanel>
            <TextBlock Text="{Binding PptCheckSummary}" TextWrapping="Wrap" FontWeight="SemiBold">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                  <Setter Property="Foreground" Value="{StaticResource OkTextBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding PptCheckLevel}" Value="{x:Static ppt:PptCheckLevel.Warning}">
                      <Setter Property="Foreground" Value="{StaticResource WarnTextBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding PptCheckLevel}" Value="{x:Static ppt:PptCheckLevel.Error}">
                      <Setter Property="Foreground" Value="{StaticResource DangerTextBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <ItemsControl ItemsSource="{Binding PptCheckLines}" Margin="0,8,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Margin="0,2"
                             Foreground="{StaticResource MutedBrush}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <TextBlock Text="Dissolvenza" FontSize="15" FontWeight="SemiBold" Margin="0,22,0,6" />
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" Width="70" TextAlignment="Right" VerticalAlignment="Center"
                     Text="{Binding FadeDurationMs, StringFormat={}{0:0} ms}" />
          <Slider Minimum="{Binding MinFade}" Maximum="{Binding MaxFade}" Value="{Binding FadeDurationMs}"
                  TickFrequency="50" IsSnapToTickEnabled="True" SmallChange="50" LargeChange="100"
                  VerticalAlignment="Center" />
        </DockPanel>
        <CheckBox Margin="0,8,0,0" IsChecked="{Binding HardCut}" Content="Taglio secco (nessuna dissolvenza)" />

        <!-- Aggiornamenti: solo su richiesta (nessun controllo all'avvio) -->
        <TextBlock Text="Aggiornamenti" FontSize="15" FontWeight="SemiBold" Margin="0,22,0,6" />
        <StackPanel DataContext="{Binding Updates}">
          <TextBlock Text="{Binding InstalledText}" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6" />
          <Button Content="{Binding CheckButtonText}" Command="{Binding CheckCommand}" HorizontalAlignment="Left" Padding="16,8" />
          <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource WarnTextBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" Height="8" Margin="0,8,0,0"
                       Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}" />
          <Border Margin="0,10,0,0" CornerRadius="6" Padding="12,10" BorderThickness="1" MaxHeight="150"
                  Background="{StaticResource OkBgBrush}" BorderBrush="{StaticResource OkBorderBrush}"
                  Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <TextBlock Text="{Binding Notes}" TextWrapping="Wrap" />
            </ScrollViewer>
          </Border>
          <Button Content="{Binding InstallButtonText}" Command="{Binding InstallCommand}" HorizontalAlignment="Left" Padding="16,8"
                  Margin="0,10,0,0" Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}" />
        </StackPanel>

        <!-- Tasti: globali dell'app, si salvano subito -->
        <TextBlock Text="Tasti" FontSize="15" FontWeight="SemiBold" Margin="0,22,0,6" />
        <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Valgono per tutta l'app (non per l'evento) e si salvano subito. Funzionano anche con il focus sullo slideshow o sul clicker del relatore. Esc è sempre PANIC." />
        <ItemsControl ItemsSource="{Binding Keys.Rows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="190" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <ItemsControl ItemsSource="{Binding Chips}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                                Padding="8,2" Margin="0,2,6,2">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Text}" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <Button Content="&#215;" Padding="6,0" Margin="6,0,0,0" FontSize="14" MinWidth="0"
                                    Command="{Binding DataContext.Keys.RemoveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" ToolTip="Togli questo tasto">
                              <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanRemove}" Value="False">
                                      <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </Button.Style>
                            </Button>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="premi un tasto..." Foreground="{StaticResource WarnTextBrush}" VerticalAlignment="Center" Margin="4,0,0,0">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </StackPanel>
                <Button Grid.Column="2" Content="+ Aggiungi" Padding="10,3" Margin="8,0,0,0"
                        Command="{Binding DataContext.Keys.StartCaptureCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <DockPanel Margin="0,8,0,0">
          <Button DockPanel.Dock="Left" Content="Ripristina predefiniti" Command="{Binding Keys.ResetDefaultsCommand}" Padding="10,4" />
          <TextBlock Text="{Binding Keys.Status}" TextWrapping="Wrap" VerticalAlignment="Center"
                     Foreground="{StaticResource MutedBrush}" Margin="12,0,0,0" />
        </DockPanel>
      </StackPanel>
    </ScrollViewer>

    <DockPanel Grid.Row="1" Margin="0,16,0,0">
      <Button DockPanel.Dock="Right" Content="Chiudi" Margin="8,0,0,0" Click="OnCloseClick" />
      <Button DockPanel.Dock="Right" Content="Applica" Background="{StaticResource TappoBrush}" Command="{Binding ApplyCommand}" />
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center"
                 Foreground="{StaticResource MutedBrush}" Margin="0,0,12,0" />
    </DockPanel>
  </Grid>
</Window>
