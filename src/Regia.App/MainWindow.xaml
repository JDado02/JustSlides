<Window x:Class="Regia.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Regia.Core.Wave;assembly=Regia.Core"
        Style="{StaticResource {x:Type Window}}"
        Title="Regia - Slide Center" Width="760" Height="960" MinWidth="560" MinHeight="760"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,14">
      <Button DockPanel.Dock="Right" Content="Impostazioni" Click="OnSettingsClick" />
      <TextBlock Text="REGIA" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
    </DockPanel>

    <!-- Stato onda ben visibile -->
    <Border Grid.Row="1" CornerRadius="10" MinHeight="110" Margin="0,0,0,14">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Background" Value="{StaticResource TappoBrush}" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding State}" Value="{x:Static core:WaveState.InOnda}">
              <Setter Property="Background" Value="{StaticResource OnAirBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="{x:Static core:WaveState.InTransizioneIn}">
              <Setter Property="Background" Value="{StaticResource TransitionBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="{x:Static core:WaveState.InTransizioneOut}">
              <Setter Property="Background" Value="{StaticResource TransitionBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="{x:Static core:WaveState.Caricamento}">
              <Setter Property="Background" Value="{StaticResource TransitionBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="{x:Static core:WaveState.Errore}">
              <Setter Property="Background" Value="{StaticResource ErrorBrush}" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <TextBlock Text="{Binding StateText}" FontSize="48" FontWeight="Bold" Foreground="White"
                 HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>

    <!-- Avvisi (monitor mancante, errori...) -->
    <StackPanel Grid.Row="2">
    <Border Background="#FF4A2B00" BorderBrush="#FFB26A00" BorderThickness="1" CornerRadius="6"
            Padding="12,8" Margin="0,0,0,14">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding HasWarning}" Value="True">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" Foreground="#FFFFD79A" FontSize="14" />
    </Border>

    <!-- Avviso fisso: PowerPoint suona sul predefinito di Windows, non sul dispositivo scelto -->
    <Border Background="#FF4A2B00" BorderBrush="#FFB26A00" BorderThickness="1" CornerRadius="6"
            Padding="12,8" Margin="0,0,0,14">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding HasAudioDeviceWarning}" Value="True">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Apri impostazioni audio" Command="{Binding OpenWindowsSoundSettingsCommand}"
                Padding="12,4" Margin="12,0,0,0" VerticalAlignment="Center" />
        <TextBlock Text="{Binding AudioDeviceWarning}" TextWrapping="Wrap" Foreground="#FFFFD79A" FontSize="14"
                   VerticalAlignment="Center" />
      </DockPanel>
    </Border>
    </StackPanel>

    <!-- Lista file provvisoria (la scaletta vera arriva in M6) -->
    <DockPanel Grid.Row="3" Margin="0,0,0,14">
      <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
        <StackPanel Orientation="Horizontal">
          <Button Content="Aggiungi file..." Click="OnAddFilesClick" Padding="14,6" />
          <Button Content="Rimuovi" Command="{Binding RemoveSelectedCommand}" Padding="14,6" Margin="8,0,0,0" />
        </StackPanel>

        <!-- Stato di PowerPoint/PptHost: solo se c'è un PPT in lista -->
        <TextBlock Text="{Binding PptStatusText}" Margin="0,8,0,0" Opacity="0.75">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding HasPptItems}" Value="True">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>

        <!-- Opzioni del video selezionato: valgono dal prossimo GO e si ricordano per ogni file -->
        <StackPanel Margin="0,10,0,0">
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelectedAudio}" Value="True">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>
          <StackPanel Orientation="Horizontal">
            <StackPanel.Style>
              <Style TargetType="StackPanel">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsSelectedVideo}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </StackPanel.Style>
            <TextBlock Text="A fine video:" VerticalAlignment="Center" Margin="0,0,10,0" />
            <RadioButton Content="Torna al Tappo" GroupName="VideoEnd" IsChecked="{Binding EndReturnToTappo}" />
            <RadioButton Content="Fermo" GroupName="VideoEnd" IsChecked="{Binding EndHoldLastFrame}"
                         ToolTip="Resta fermo sull'ultimo fotogramma" />
            <RadioButton Content="Loop" GroupName="VideoEnd" IsChecked="{Binding EndLoop}" />
          </StackPanel>
          <DockPanel Margin="0,8,0,0">
            <TextBlock DockPanel.Dock="Left" Text="Volume salvato:" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBlock DockPanel.Dock="Right" Width="44" TextAlignment="Right" VerticalAlignment="Center"
                       Text="{Binding SelectedVolume, StringFormat={}{0}%}" />
            <Slider Minimum="0" Maximum="100" Value="{Binding SelectedVolume}" SmallChange="5" LargeChange="10"
                    IsMoveToPointEnabled="True" VerticalAlignment="Center" Margin="0,0,8,0" Focusable="False"
                    ToolTip="Volume con cui questo video o PowerPoint parte a ogni messa in onda (si ricorda per ogni file)" />
          </DockPanel>
        </StackPanel>
      </StackPanel>
      <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
               DisplayMemberPath="DisplayName" FontSize="16" MinHeight="120" />
    </DockPanel>

    <!-- Pagina N/M per i PDF e frecce -->
    <Grid Grid.Row="4" Margin="0,0,0,14" Height="52">
      <Grid.Style>
        <Style TargetType="Grid">
          <Setter Property="Visibility" Value="Hidden" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding HasPage}" Value="True">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Grid.Style>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="90" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="90" />
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" Content="&#9664;" Command="{Binding PreviousPageCommand}" FontSize="22" />
      <TextBlock Grid.Column="1" Text="{Binding PageText}" FontSize="26" FontWeight="SemiBold"
                 HorizontalAlignment="Center" VerticalAlignment="Center" />
      <Button Grid.Column="2" Content="&#9654;" Command="{Binding NextPageCommand}" FontSize="22" />
    </Grid>

    <!-- Video in onda: countdown, play/pausa, volume (il pannello Program completo arriva in M7) -->
    <StackPanel Grid.Row="5">
    <Border Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="14,10" Margin="0,0,0,14">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsVideoOnAir}" Value="True">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="0,0,24,0">
          <TextBlock Text="{Binding RemainingText}" FontSize="48" FontWeight="Bold" FontFamily="Consolas" />
          <TextBlock Text="{Binding ElapsedText}" FontSize="14" Foreground="{StaticResource MutedBrush}" />
        </StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <DockPanel>
            <Button DockPanel.Dock="Left" Content="{Binding PauseButtonText}" Command="{Binding TogglePauseCommand}"
                    Width="90" Padding="0,8" />
            <TextBlock DockPanel.Dock="Left" Text="Volume ora" VerticalAlignment="Center" Margin="14,0,0,0"
                       ToolTip="Volume dal vivo: vale solo per questa riproduzione" />
            <CheckBox DockPanel.Dock="Right" Content="Mute" IsChecked="{Binding IsMuted}" VerticalAlignment="Center" Margin="12,0,0,0" />
            <TextBlock DockPanel.Dock="Right" Width="40" TextAlignment="Right" VerticalAlignment="Center"
                       Text="{Binding Volume, StringFormat={}{0}%}" />
            <Slider Minimum="0" Maximum="100" Value="{Binding Volume}" SmallChange="5" LargeChange="10"
                    VerticalAlignment="Center" Margin="14,0,8,0" Focusable="False" />
          </DockPanel>
          <DockPanel Margin="0,10,0,0">
            <Button DockPanel.Dock="Left" Content="&#9664;&#9664; 10 s" Command="{Binding SeekBackCommand}"
                    Width="90" Padding="0,6" ToolTip="Indietro di 10 secondi" />
            <Button DockPanel.Dock="Right" Content="10 s &#9654;&#9654;" Command="{Binding SeekForwardCommand}"
                    Width="90" Padding="0,6" ToolTip="Avanti di 10 secondi" />
            <Slider Minimum="0" Maximum="{Binding DurationSeconds}" Value="{Binding PositionSeconds}"
                    IsMoveToPointEnabled="True" Focusable="False" VerticalAlignment="Center" Margin="14,0,14,0"
                    PreviewMouseLeftButtonDown="OnScrubStart" PreviewMouseLeftButtonUp="OnScrubEnd"
                    Thumb.DragStarted="OnScrubStart" Thumb.DragCompleted="OnScrubEnd"
                    ToolTip="Trascina per scorrere il video (anche in pausa)" />
          </DockPanel>
        </StackPanel>
      </Grid>
    </Border>

    <!-- PowerPoint in onda: solo volume dal vivo e Mute (agiscono sulla sessione audio di POWERPNT.EXE) -->
    <Border Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="14,10" Margin="0,0,0,14">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsSlideShowAudioOnAir}" Value="True">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <DockPanel>
        <TextBlock DockPanel.Dock="Left" Text="Volume ora" VerticalAlignment="Center"
                   ToolTip="Volume dal vivo dell'audio di PowerPoint: vale solo per questa messa in onda" />
        <CheckBox DockPanel.Dock="Right" Content="Mute" IsChecked="{Binding IsMuted}" VerticalAlignment="Center" Margin="12,0,0,0" />
        <TextBlock DockPanel.Dock="Right" Width="40" TextAlignment="Right" VerticalAlignment="Center"
                   Text="{Binding Volume, StringFormat={}{0}%}" />
        <Slider Minimum="0" Maximum="100" Value="{Binding Volume}" SmallChange="5" LargeChange="10"
                VerticalAlignment="Center" Margin="14,0,8,0" Focusable="False" />
      </DockPanel>
    </Border>
    </StackPanel>

    <Grid Grid.Row="6" Margin="0,0,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="14" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" Command="{Binding GoCommand}" Background="{StaticResource GoBrush}"
              FontSize="22" FontWeight="SemiBold" Padding="14,18">
        <TextBlock Text="GO  (Spazio / Invio)" Foreground="White" />
      </Button>
      <Button Grid.Column="2" Command="{Binding BackToTappoCommand}" FontSize="22" Padding="14,18">
        <TextBlock Text="TORNA AL TAPPO" Foreground="White" />
      </Button>
    </Grid>

    <Button Grid.Row="7" Command="{Binding PanicCommand}" Background="#FFB71C1C" Padding="14,26">
      <TextBlock Text="PANIC  (Esc)" FontSize="34" FontWeight="Bold" Foreground="White" />
    </Button>
  </Grid>
</Window>
