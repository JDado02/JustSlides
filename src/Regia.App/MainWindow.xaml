<Window x:Class="Regia.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Regia.App"
        Style="{StaticResource {x:Type Window}}"
        Title="JustSlides" Width="1500" Height="860" MinWidth="1280" MinHeight="780"
        Icon="pack://application:,,,/Regia.Output;component/Assets/JustSlides.ico"
        MaxWidth="{x:Static SystemParameters.MaximizedPrimaryScreenWidth}"
        MaxHeight="{x:Static SystemParameters.MaximizedPrimaryScreenHeight}"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <app:ThumbnailConverter x:Key="Thumb" />
    <app:PreflightBrushConverter x:Key="PreflightBrush" />
    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <!-- Altezza MINIMA della zona info sotto ogni riquadro 16:9: se la finestra è più alta le info occupano lo spazio che resta -->
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="InfoHeight">140</sys:Double>

    <!-- Voce della scaletta: linea di inserimento durante il riordino, voce esclusa attenuata -->
    <Style x:Key="ScalettaItem" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="BorderBrush" Value="#FFFFB300" />
      <Setter Property="BorderThickness" Value="0" />
      <Style.Triggers>
        <Trigger Property="app:DragDropState.DropPosition" Value="Before">
          <Setter Property="BorderThickness" Value="0,3,0,0" />
        </Trigger>
        <Trigger Property="app:DragDropState.DropPosition" Value="After">
          <Setter Property="BorderThickness" Value="0,0,0,3" />
        </Trigger>
        <DataTrigger Binding="{Binding Excluded}" Value="True">
          <Setter Property="Opacity" Value="0.45" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Avvisi: stesso aspetto compatto, tre gravità -->
    <Style x:Key="BannerBase" TargetType="Border">
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="{StaticResource WarnBgBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource WarnBorderBrush}" />
    </Style>
    <Style x:Key="BannerDanger" TargetType="Border" BasedOn="{StaticResource BannerBase}">
      <Setter Property="Background" Value="{StaticResource DangerBgBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource DangerBorderBrush}" />
    </Style>
    <Style x:Key="BannerStress" TargetType="Border" BasedOn="{StaticResource BannerBase}">
      <Setter Property="Background" Value="{StaticResource StressBgBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource StressBorderBrush}" />
    </Style>
    <Style x:Key="BannerSource" TargetType="Border" BasedOn="{StaticResource BannerBase}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding SourceMessageIsError}" Value="True">
          <Setter Property="Background" Value="{StaticResource DangerBgBrush}" />
          <Setter Property="BorderBrush" Value="{StaticResource DangerBorderBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid Margin="16,12,16,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="40" />
      <RowDefinition Height="8" />
      <RowDefinition Height="80" />
      <RowDefinition Height="12" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ============================ Barra superiore ============================ -->
    <DockPanel Grid.Row="0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Content="Nuovo evento" Command="{Binding NewEventCommand}" Margin="0,0,8,0" Padding="12,6" />
        <Button Click="OnSettingsClick" Padding="12,6" AutomationProperties.Name="Impostazioni">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE713;" Style="{StaticResource IconText}" Margin="0,0,8,0" />
            <TextBlock Text="Impostazioni" />
          </StackPanel>
        </Button>
      </StackPanel>
      <!-- Logotipo: icona + "Just" leggero e "Slides" in grassetto -->
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Image Source="pack://application:,,,/Regia.Output;component/Assets/JustSlides-512.png" Width="30" Height="30"
               RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,10,0" />
        <TextBlock FontSize="21" VerticalAlignment="Center">
          <Run Text="Just" FontWeight="Light" Foreground="{StaticResource MutedBrush}" /><Run Text="Slides" FontWeight="SemiBold" />
        </TextBlock>
      </StackPanel>
      <Border Style="{StaticResource StateFill}" CornerRadius="12" Padding="14,3" Margin="18,0,0,0" VerticalAlignment="Center">
        <TextBlock Text="{Binding StateText}" FontWeight="Bold" Foreground="White" />
      </Border>
      <TextBlock Text="{Binding SourceLabel}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                 Margin="18,0,12,0" TextTrimming="CharacterEllipsis" />
    </DockPanel>

    <!-- ============================ Area avvisi (riservata, altezza fissa) ============================ -->
    <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1" CornerRadius="6" Padding="6,6,6,2">
      <Grid>
        <!-- Nessun avviso: scritta discreta -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding HasWarning}" Value="False" />
                    <Condition Binding="{Binding HasAudioDeviceWarning}" Value="False" />
                    <Condition Binding="{Binding HasSourceMessage}" Value="False" />
                    <Condition Binding="{Binding HasStressStatus}" Value="False" />
                    <Condition Binding="{Binding HasOutputLost}" Value="False" />
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>
          <TextBlock Text="&#xE73E;" Style="{StaticResource IconText}" Foreground="{StaticResource DimBrush}" Margin="0,0,8,0" />
          <TextBlock Text="Nessun avviso" Foreground="{StaticResource DimBrush}" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
          <StackPanel>
            <!-- Output scollegato (critico, fisso finché il monitor non torna) -->
            <Border Style="{StaticResource BannerDanger}" Visibility="{Binding HasOutputLost, Converter={StaticResource BoolToVis}}">
              <TextBlock Text="{Binding OutputLostMessage}" TextWrapping="Wrap" Foreground="{StaticResource DangerTextBrush}"
                         FontWeight="SemiBold" />
            </Border>

            <!-- Stress test in corso (Esc = PANIC e interrompe) -->
            <Border Style="{StaticResource BannerStress}" Visibility="{Binding HasStressStatus, Converter={StaticResource BoolToVis}}">
              <TextBlock Text="{Binding StressStatus}" TextWrapping="Wrap" Foreground="{StaticResource StressTextBrush}"
                         FontWeight="SemiBold" />
            </Border>

            <Border Style="{StaticResource BannerBase}" Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}">
              <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" Foreground="{StaticResource WarnTextBrush}" />
            </Border>

            <Border Style="{StaticResource BannerBase}" Visibility="{Binding HasAudioDeviceWarning, Converter={StaticResource BoolToVis}}">
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="Apri impostazioni audio" Command="{Binding OpenWindowsSoundSettingsCommand}"
                        Padding="10,2" Margin="12,0,0,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding AudioDeviceWarning}" TextWrapping="Wrap" Foreground="{StaticResource WarnTextBrush}"
                           VerticalAlignment="Center" />
              </DockPanel>
            </Border>

            <!-- Cartella contenuti: non configurata (ambra) o non raggiungibile (rosso) -->
            <Border Style="{StaticResource BannerSource}" Visibility="{Binding HasSourceMessage, Converter={StaticResource BoolToVis}}">
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="Imposta cartella..." Click="OnSettingsClick"
                        Padding="10,2" Margin="12,0,0,0" VerticalAlignment="Center"
                        Visibility="{Binding SourceNotConfigured, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding SourceMessage}" TextWrapping="Wrap" Foreground="{StaticResource WarnTextBrush}"
                           VerticalAlignment="Center" />
              </DockPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>

    <Grid Grid.Row="4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="400" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- ============================ SINISTRA: scaletta ============================ -->
      <DockPanel Grid.Column="0">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" Height="24">
          <CheckBox DockPanel.Dock="Right" Content="Mostra esclusi" IsChecked="{Binding ShowExcluded}"
                    VerticalAlignment="Center" Margin="0" />
          <TextBlock Text="SCALETTA" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
        </DockPanel>

        <!-- Dettagli della voce selezionata: sessione e relatore sempre presenti; "A fine video" e "Volume salvato" solo se servono -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,8,0,0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Sessione" Foreground="{StaticResource MutedBrush}"
                       VerticalAlignment="Center" Margin="0,0,12,6" />
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SelectedSession, UpdateSourceTrigger=LostFocus}"
                     IsEnabled="{Binding HasEditableSelection}" Margin="0,0,0,6" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Relatore" Foreground="{StaticResource MutedBrush}"
                       VerticalAlignment="Center" Margin="0,0,12,0" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedItem.Speaker, UpdateSourceTrigger=LostFocus}"
                     IsEnabled="{Binding HasEditableSelection}" />

            <!-- Solo con un video selezionato (Collapsed: con PPT/PDF non lascia spazio vuoto) -->
            <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,12,0,0"
                        Visibility="{Binding IsSelectedVideo, Converter={StaticResource BoolToVis}}">
              <TextBlock Text="A fine video" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
              <RadioButton Content="Torna al Tappo" GroupName="VideoEnd" IsChecked="{Binding EndReturnToTappo}" />
              <RadioButton Content="Fermo" GroupName="VideoEnd" IsChecked="{Binding EndHoldLastFrame}"
                           ToolTip="Resta fermo sull'ultimo fotogramma" />
              <RadioButton Content="Loop" GroupName="VideoEnd" IsChecked="{Binding EndLoop}" Margin="0" />
            </StackPanel>

            <DockPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,10,0,0"
                       Visibility="{Binding IsSelectedAudio, Converter={StaticResource BoolToVis}}">
              <TextBlock DockPanel.Dock="Left" Text="Volume salvato" Foreground="{StaticResource MutedBrush}"
                         VerticalAlignment="Center" Margin="0,0,12,0" />
              <TextBlock DockPanel.Dock="Right" Width="44" TextAlignment="Right" VerticalAlignment="Center"
                         FontFamily="{StaticResource MonoFont}" Text="{Binding SelectedVolume, StringFormat={}{0}%}" />
              <Slider Minimum="0" Maximum="100" Value="{Binding SelectedVolume}" SmallChange="5" LargeChange="10"
                      IsMoveToPointEnabled="True" VerticalAlignment="Center" Margin="0,0,8,0" Focusable="False"
                      ToolTip="Volume con cui questo video o PowerPoint parte a ogni messa in onda (si ricorda per ogni file)" />
            </DockPanel>

            <!-- Stato di PowerPoint/PptHost: riga sempre presente, visibile solo se c'è un PPT in lista -->
            <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Text="{Binding PptStatusText}" Margin="0,10,0,0" Height="18"
                       TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedBrush}">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                  <Setter Property="Opacity" Value="0" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasPptItems}" Value="True">
                      <Setter Property="Opacity" Value="1" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>
        </Border>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
          <Button DockPanel.Dock="Right" Content="Nascondi / mostra voce" Command="{Binding ToggleExcludeSelectedCommand}" Padding="12,6"
                  ToolTip="Toglie la voce dalla scaletta senza toccare la cartella (si può rimettere con 'Mostra esclusi')" />
          <Button Content="Aggiungi file..." Click="OnAddFilesClick" Padding="12,6" HorizontalAlignment="Left"
                  ToolTip="Copia i file nella cartella contenuti: compaiono in scaletta da soli" />
        </DockPanel>

        <ListBox x:Name="ScalettaList" ItemsSource="{Binding ItemsView}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                 ItemContainerStyle="{StaticResource ScalettaItem}" AllowDrop="True"
                 BorderThickness="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 PreviewMouseLeftButtonDown="OnListMouseDown" PreviewMouseMove="OnListMouseMove"
                 DragOver="OnListDragOver" DragLeave="OnListDragLeave" Drop="OnListDrop">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <!-- Altezza fissa: ogni voce occupa lo stesso spazio anche senza sessione/relatore -->
              <Grid Height="56">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="88" Height="50" Background="{StaticResource WellBrush}" CornerRadius="3"
                        VerticalAlignment="Center">
                  <Grid>
                    <TextBlock Text="{Binding KindText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource DimBrush}" FontWeight="Bold" />
                    <Image Source="{Binding ThumbnailPath, Converter={StaticResource Thumb}, ConverterParameter=176}"
                           Stretch="Uniform" />
                  </Grid>
                </Border>

                <Grid Grid.Column="1" Margin="12,2,8,2">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="22" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="16" />
                  </Grid.RowDefinitions>
                  <TextBlock Grid.Row="0" Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Row="1" Text="{Binding Session}" FontSize="12" Foreground="{StaticResource MutedBrush}"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Row="2" Text="{Binding Speaker}" FontSize="12" TextTrimming="CharacterEllipsis" />
                </Grid>

                <Grid Grid.Column="2" Width="86">
                  <TextBlock Text="{Binding StatusText}" FontSize="10" FontWeight="Bold" Foreground="#FFFFB300"
                             HorizontalAlignment="Right" VerticalAlignment="Top" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,6">
                    <TextBlock Text="{Binding KindText}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Ellipse Width="12" Height="12" VerticalAlignment="Center"
                             Fill="{Binding Preflight, Converter={StaticResource PreflightBrush}}"
                             ToolTip="{Binding PreflightSummary}" />
                  </StackPanel>
                </Grid>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <!-- ============================ DESTRA: Preview | Program + controlli ============================ -->
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="12" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- I due riquadri 16:9 hanno SEMPRE la stessa dimensione (decisa solo dallo spazio disponibile) -->
        <app:MonitorPairPanel Grid.Row="0" Gap="16" InfoHeight="{StaticResource InfoHeight}">

          <!-- 1) Riquadro Preview: solo anteprima, mai per l'onda -->
          <Border DataContext="{Binding Preview}" Background="{StaticResource WellBrush}"
                  BorderBrush="{StaticResource PreviewFrameBrush}" BorderThickness="2" ClipToBounds="True">
            <Grid>
              <Image Source="{Binding Image}" Stretch="Uniform" AutomationProperties.AutomationId="PreviewImage" />
              <TextBlock Text="{Binding Placeholder}" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Foreground="{StaticResource MutedBrush}" FontSize="14" TextAlignment="Center" TextWrapping="Wrap" Margin="16,0">
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding HasImage}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Grid>
          </Border>

          <!-- 2) Riquadro Program: OutputBox = area dello specchio DWM (simulazione) e della cattura, dentro la cornice di stato -->
          <Border Style="{StaticResource StateFrame}" BorderThickness="2" Background="{StaticResource WellBrush}">
            <Border x:Name="OutputBox" Background="{StaticResource WellBrush}" ClipToBounds="True"
                    ToolTip="Ciò che si vede ora sull'output">
              <Image Source="{Binding Program.CaptureImage}" Stretch="Uniform" AutomationProperties.AutomationId="ProgramImage" />
            </Border>
          </Border>

          <!-- 3) Info Preview: occupa tutto lo spazio sotto il riquadro; le righe scorrono solo se non entrano -->
          <Grid DataContext="{Binding Preview}" Margin="0,8,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="18" />
              <RowDefinition Height="24" />
              <RowDefinition Height="20" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0">
              <Ellipse DockPanel.Dock="Right" Width="12" Height="12" VerticalAlignment="Center"
                       Fill="{Binding Status, Converter={StaticResource PreflightBrush}}" />
              <TextBlock Text="PREVIEW" Style="{StaticResource SectionLabel}" Foreground="{StaticResource PreviewFrameBrush}" />
            </DockPanel>
            <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Row="2" Text="{Binding Subtitle}" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />

            <!-- Righe del pre-flight, oppure pagine del PDF -->
            <Grid Grid.Row="3" Margin="0,6,0,0">
              <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                <ScrollViewer.Style>
                  <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding HasPages}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ScrollViewer.Style>
                <ItemsControl ItemsSource="{Binding Lines}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="13" Margin="0,2" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>

              <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage, Mode=TwoWay}"
                       BorderThickness="0" Background="Transparent" VerticalAlignment="Top"
                       ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListBox.Style>
                  <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding HasPages}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ListBox.Style>
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <VirtualizingStackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="Margin" Value="0,0,4,6" />
                    <Setter Property="VerticalAlignment" Value="Top" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                          <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="2"
                                  CornerRadius="4" Padding="3,2">
                            <ContentPresenter />
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PreviewFrameBrush}" />
                              <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectionBrush}" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Width="52">
                      <Image Source="{Binding Image}" Height="38" Stretch="Uniform" />
                      <TextBlock Text="{Binding Number}" HorizontalAlignment="Center" FontSize="11"
                                 Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Grid>

          <!-- 4) Info Program -->
          <Grid Margin="0,8,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="18" />
              <RowDefinition Height="46" />
              <RowDefinition Height="34" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="PROGRAM" Style="{StaticResource SectionLabel}" />

            <!-- Stato dell'onda, sempre della stessa altezza -->
            <Border Grid.Row="1" Style="{StaticResource StateFill}" CornerRadius="6" Padding="14,0">
              <DockPanel VerticalAlignment="Center">
                <TextBlock DockPanel.Dock="Left" Text="{Binding StateText}" FontSize="22" FontWeight="Bold" Foreground="White" />
                <TextBlock Text="{Binding Program.OnAirName}" FontSize="13" Foreground="White" Opacity="0.9"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16,0,0,0"
                           TextTrimming="CharacterEllipsis" />
              </DockPanel>
            </Border>

            <!-- Pagina / slide N/M con le frecce: visibili solo con un PDF o un PPT in onda (Hidden = lo spazio resta, nulla si sposta) -->
            <Grid Grid.Row="2" Margin="0,4,0,0">
              <Grid.Style>
                <Style TargetType="Grid">
                  <Setter Property="Visibility" Value="Hidden" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasPage}" Value="True">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Grid.Style>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="56" />
              </Grid.ColumnDefinitions>
              <Button Grid.Column="0" Command="{Binding PreviousPageCommand}" Padding="0,2"
                      AutomationProperties.Name="Pagina precedente" ToolTip="Pagina o slide precedente">
                <TextBlock Text="&#xE76B;" Style="{StaticResource IconText}" />
              </Button>
              <TextBlock Grid.Column="1" Text="{Binding PageText}" FontSize="18" FontWeight="SemiBold"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
              <Button Grid.Column="2" Command="{Binding NextPageCommand}" Padding="0,2"
                      AutomationProperties.Name="Pagina successiva" ToolTip="Pagina o slide successiva">
                <TextBlock Text="&#xE76C;" Style="{StaticResource IconText}" />
              </Button>
            </Grid>

            <!-- Tappo PowerPoint fermo: frecce a schermo (solo mouse), nella stessa riga delle frecce pagina (mai insieme: a Tappo non c'è pagina) -->
            <Grid Grid.Row="2" Margin="0,4,0,0">
              <Grid.Style>
                <Style TargetType="Grid">
                  <Setter Property="Visibility" Value="Hidden" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasTappoNav}" Value="True">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Grid.Style>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="56" />
              </Grid.ColumnDefinitions>
              <Button Grid.Column="0" Command="{Binding TappoPreviousSlideCommand}" Padding="0,2" Focusable="False"
                      AutomationProperties.Name="Slide precedente del Tappo" ToolTip="Slide precedente del Tappo (solo mouse)">
                <TextBlock Text="&#xE76B;" Style="{StaticResource IconText}" />
              </Button>
              <TextBlock Grid.Column="1" Text="{Binding TappoSlideText}" FontSize="16" FontWeight="SemiBold"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
              <Button Grid.Column="2" Command="{Binding TappoNextSlideCommand}" Padding="0,2" Focusable="False"
                      AutomationProperties.Name="Slide successiva del Tappo" ToolTip="Slide successiva del Tappo (solo mouse)">
                <TextBlock Text="&#xE76C;" Style="{StaticResource IconText}" />
              </Button>
            </Grid>

            <TextBlock Grid.Row="3" Text="{Binding Program.NextText}" FontSize="13" Margin="0,4,0,0"
                       TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedBrush}" />
          </Grid>
        </app:MonitorPairPanel>

        <!-- ============================ Pannello controlli (altezza fissa) ============================ -->
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="14,12">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="56" />
              <RowDefinition Height="8" />
              <RowDefinition Height="30" />
              <RowDefinition Height="12" />
              <RowDefinition Height="64" />
            </Grid.RowDefinitions>

            <!-- Video: countdown, Play/Pausa, scorrimento (attivi solo con un video in onda) -->
            <Grid Grid.Row="0" IsEnabled="{Binding IsVideoOnAir}">
              <Grid.Style>
                <Style TargetType="Grid">
                  <Setter Property="Visibility" Value="Hidden" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsVideoOnAir}" Value="True">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Grid.Style>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="{Binding RemainingText}" FontSize="30" FontWeight="Bold" FontFamily="{StaticResource MonoFont}" />
                <TextBlock Text="{Binding ElapsedText}" FontSize="12" Foreground="{StaticResource MutedBrush}"
                           FontFamily="{StaticResource MonoFont}" />
              </StackPanel>
              <DockPanel Grid.Column="1" VerticalAlignment="Center">
                <Button DockPanel.Dock="Left" Content="{Binding PauseButtonText}" Command="{Binding TogglePauseCommand}"
                        Width="92" Padding="0,5" />
                <Button DockPanel.Dock="Left" Content="&#9664;&#9664; 10 s" Command="{Binding SeekBackCommand}"
                        Width="78" Padding="0,5" Margin="8,0,0,0" ToolTip="Indietro di 10 secondi" />
                <Button DockPanel.Dock="Right" Content="10 s &#9654;&#9654;" Command="{Binding SeekForwardCommand}"
                        Width="78" Padding="0,5" ToolTip="Avanti di 10 secondi" />
                <Slider Minimum="0" Maximum="{Binding DurationSeconds}" Value="{Binding PositionSeconds}"
                        IsMoveToPointEnabled="True" Focusable="False" VerticalAlignment="Center" Margin="14,0"
                        PreviewMouseLeftButtonDown="OnScrubStart" PreviewMouseLeftButtonUp="OnScrubEnd"
                        Thumb.DragStarted="OnScrubStart" Thumb.DragCompleted="OnScrubEnd"
                        ToolTip="Trascina per scorrere il video (anche in pausa)" />
              </DockPanel>
            </Grid>

            <!-- Audio (video e PowerPoint): volume dal vivo e Mute -->
            <DockPanel Grid.Row="2" IsEnabled="{Binding IsAudioOnAir}">
              <DockPanel.Style>
                <Style TargetType="DockPanel">
                  <Setter Property="Visibility" Value="Hidden" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsAudioOnAir}" Value="True">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </DockPanel.Style>
              <TextBlock DockPanel.Dock="Left" Text="Volume ora" Foreground="{StaticResource MutedBrush}" Width="92"
                         VerticalAlignment="Center" ToolTip="Volume dal vivo: vale solo per questa messa in onda" />
              <CheckBox DockPanel.Dock="Right" Content="Mute" IsChecked="{Binding IsMuted}" VerticalAlignment="Center"
                        Margin="14,0,0,0" />
              <TextBlock DockPanel.Dock="Right" Width="44" TextAlignment="Right" VerticalAlignment="Center"
                         FontFamily="{StaticResource MonoFont}" Text="{Binding Volume, StringFormat={}{0}%}" />
              <Slider Minimum="0" Maximum="100" Value="{Binding Volume}" SmallChange="5" LargeChange="10"
                      VerticalAlignment="Center" Margin="8,0" Focusable="False" />
            </DockPanel>

            <!-- GO / Torna al Tappo / PANIC: sempre qui, sempre grandi -->
            <Grid Grid.Row="4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Button Grid.Column="0" Command="{Binding GoCommand}" Style="{StaticResource GoButton}">
                <TextBlock Text="{Binding Program.GoLabel}" FontSize="18" FontWeight="Bold" Foreground="White" />
              </Button>
              <Button Grid.Column="2" Command="{Binding BackToTappoCommand}" Style="{StaticResource BackButton}">
                <TextBlock Text="{Binding Program.BackLabel}" FontSize="18" FontWeight="Bold" Foreground="White" />
              </Button>
              <Button Grid.Column="4" Command="{Binding PanicCommand}" Style="{StaticResource PanicButton}">
                <TextBlock Text="{Binding Program.PanicLabel}" FontSize="20" FontWeight="Bold" Foreground="White" />
              </Button>
            </Grid>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
