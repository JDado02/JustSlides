<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Regia.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <VlcWindowsX86IncludeFiles>false</VlcWindowsX86IncludeFiles>
    <VlcWindowsX64IncludeFiles>true</VlcWindowsX64IncludeFiles>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Regia.Core\Regia.Core.csproj" />
    <ProjectReference Include="..\Regia.Output\Regia.Output.csproj" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>
</Project>
