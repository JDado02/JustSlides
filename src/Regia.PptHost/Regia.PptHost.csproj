<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <!-- WPF solo per il Dispatcher del thread STA: nessuna finestra, nessun App.xaml -->
    <UseWPF>true</UseWPF>
    <RootNamespace>Regia.PptHost</RootNamespace>
    <!-- In Gestione attività compare come JustSlides.PptHost.exe -->
    <AssemblyName>JustSlides.PptHost</AssemblyName>
    <Product>JustSlides</Product>
    <AssemblyTitle>JustSlides PowerPoint Host</AssemblyTitle>
    <Description>JustSlides - processo che pilota PowerPoint per conto della regia</Description>
    <Version>1.2.1</Version>
    <ApplicationIcon>..\Regia.Output\Assets\JustSlides.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Regia.Core\Regia.Core.csproj" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>
</Project>
