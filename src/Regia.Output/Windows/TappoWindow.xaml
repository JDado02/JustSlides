<Window x:Class="Regia.Output.Windows.TappoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JustSlides - Output Tappo"
        Icon="pack://application:,,,/Regia.Output;component/Assets/JustSlides.ico"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" Focusable="False"
        Background="Black" Width="640" Height="360">
  <Grid>
    <Image x:Name="View" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
    <!-- Seconda immagine, solo per il crossfade tra le slide del Tappo PowerPoint (opacità 0 = invisibile) -->
    <Image x:Name="Incoming" Stretch="Uniform" Opacity="0" RenderOptions.BitmapScalingMode="HighQuality" />
  </Grid>
</Window>
