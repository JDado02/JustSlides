<Window x:Class="Regia.Output.Windows.TimerOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JustSlides - Output Timer"
        Icon="pack://application:,,,/Regia.Output;component/Assets/JustSlides.ico"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" Focusable="False" IsHitTestVisible="False"
        Background="Transparent" Width="640" Height="360">
  <!-- Finestra a pieno output, trasparente e click-through: l'unica cosa visibile è la pastiglia del timer in un angolo -->
  <Grid>
    <Border x:Name="Pill" Background="#CC000000" CornerRadius="10" Padding="18,6"
            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="24">
      <TextBlock x:Name="TimeText" Text="00:00" Foreground="White" FontWeight="Bold"
                 FontFamily="Cascadia Mono, Consolas" FontSize="48" />
    </Border>
  </Grid>
</Window>
